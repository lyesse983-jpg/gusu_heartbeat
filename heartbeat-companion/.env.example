# Start with a scripted demo. It makes no model API requests.
COMPANION_MODE=demo

# Live mode: set MODE=live and supply a tool-capable model.
# Provider: anthropic or openai (OpenAI-compatible Chat Completions).
COMPANION_PROVIDER=anthropic
COMPANION_API_KEY=
COMPANION_MODEL=

# Optional API prefix. Leave empty for the official provider endpoint.
# OpenAI-compatible example: https://your-provider.example/v1
COMPANION_BASE_URL=

COMPANION_TIMEZONE=Asia/Shanghai
COMPANION_DATA_DIR=data
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8765

# Optional on localhost. REQUIRED when listening on a non-local address,
# including Docker. Generate a long random value; never use your model API key.
COMPANION_ACCESS_TOKEN=
